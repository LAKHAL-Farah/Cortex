global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: 'node_exporter'
    file_sd_configs:
      - files:
          - '{{ prometheus_file_sd_dir }}/nodes.json'
        refresh_interval: {{ prometheus_file_sd_refresh_interval }}

  - job_name: 'prometheus'
    static_configs:
      - targets:
          - '{{ hostvars[groups["prometheus_server"][0]].ansible_host }}:{{ prometheus_port }}'
        labels:
          node: '{{ groups["prometheus_server"][0] }}'
          role: '{{ hostvars[groups["prometheus_server"][0]].node_role }}'