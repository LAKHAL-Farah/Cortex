# HELP cortex_container_up 1 if the container is running, 0 otherwise.
# TYPE cortex_container_up gauge
{% for name in sim_node_containers %}
{% if name not in sim_removed_containers %}
{% if name in sim_down_containers %}
cortex_container_up{container="{{ name }}",state="exited",health="none"} 0
{% elif name in sim_unhealthy_containers %}
cortex_container_up{container="{{ name }}",state="running",health="unhealthy"} 1
{% else %}
cortex_container_up{container="{{ name }}",state="running",health="healthy"} 1
{% endif %}
{% endif %}
{% endfor %}
# HELP cortex_container_restart_count Docker restart count of the container.
# TYPE cortex_container_restart_count gauge
{% for name in sim_node_containers %}
{% if name not in sim_removed_containers %}
cortex_container_restart_count{container="{{ name }}"} {{ 3 if name in sim_down_containers else 0 }}
{% endif %}
{% endfor %}
# HELP cortex_containers_scrape_timestamp_seconds Unix time of the last successful container scan.
# TYPE cortex_containers_scrape_timestamp_seconds gauge
cortex_containers_scrape_timestamp_seconds {{ sim_now_epoch }}
