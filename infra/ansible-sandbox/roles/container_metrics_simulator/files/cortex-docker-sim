#!/usr/bin/env python3
"""SANDBOX ONLY. A stand-in for the Docker CLI on the simulated nodes.

The sim nodes are themselves containers with no Docker daemon, so the
container telemetry the Living Model reads (adr-0012) is a textfile written by
the container_metrics_simulator role. That made `docker restart nova_compute` --
the fix Cortex proposes for a down container -- impossible to run here. This
script closes that loop for the Remediation Copilot (roadmap 4.4, adr-0015):

  docker restart|stop|start NAME [NAME...]   change a simulated container
  cortex-docker-sim seed                     (re)build state from the config
  cortex-docker-sim render                   rewrite the textfile from state

It is installed twice, as `cortex-docker-sim` and as `docker` (a symlink), and
behaves according to the name it was called by. It supports only the three verbs
above, and says so for anything else -- it is not a Docker emulator, just
enough state for "container is down -> an approved restart brings it back".

Files (override with the CORTEX_SIM_* variables, used by the tests):
  config  /etc/cortex-sim/containers.json   written by the role
  state   /var/lib/cortex-sim/state.json    {name: {state, health, restarts}}
  output  /var/lib/node_exporter/textfile/cortex_containers.prom
The output format is exactly what the role's old Jinja template produced, so
nothing that reads it changes.
"""
import json
import os
import sys
import tempfile
import time

CONFIG = os.environ.get("CORTEX_SIM_CONFIG", "/etc/cortex-sim/containers.json")
STATE = os.environ.get("CORTEX_SIM_STATE", "/var/lib/cortex-sim/state.json")
OUTPUT = os.environ.get("CORTEX_SIM_OUTPUT", "/var/lib/node_exporter/textfile/cortex_containers.prom")


def _load(path):
    with open(path) as fh:
        return json.load(fh)


def _atomic_write(path, text):
    directory = os.path.dirname(os.path.abspath(path))
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".tmp-", suffix=".swp")  # not *.prom: node_exporter ignores it
    with os.fdopen(fd, "w") as fh:
        fh.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def seed():
    """State from the role's scenario lists (down / unhealthy / removed)."""
    cfg = _load(CONFIG)
    state = {}
    for name in cfg["containers"]:
        if name in cfg.get("removed", []):
            continue  # what `docker rm` looks like: absent from the file entirely
        if name in cfg.get("down", []):
            state[name] = {"state": "exited", "health": "none", "restarts": 3}
        elif name in cfg.get("unhealthy", []):
            state[name] = {"state": "running", "health": "unhealthy", "restarts": 0}
        else:
            state[name] = {"state": "running", "health": "healthy", "restarts": 0}
    _atomic_write(STATE, json.dumps(state, indent=2))
    render()


def render():
    cfg = _load(CONFIG)
    state = _load(STATE)
    names = [n for n in cfg["containers"] if n in state]
    lines = [
        "# HELP cortex_container_up 1 if the container is running, 0 otherwise.",
        "# TYPE cortex_container_up gauge",
    ]
    for n in names:
        s = state[n]
        up = 1 if s["state"] == "running" else 0
        lines.append(f'cortex_container_up{{container="{n}",state="{s["state"]}",health="{s["health"]}"}} {up}')
    lines += [
        "# HELP cortex_container_restart_count Docker restart count of the container.",
        "# TYPE cortex_container_restart_count gauge",
    ]
    for n in names:
        lines.append(f'cortex_container_restart_count{{container="{n}"}} {state[n]["restarts"]}')
    lines += [
        "# HELP cortex_containers_scrape_timestamp_seconds Unix time of the last successful container scan.",
        "# TYPE cortex_containers_scrape_timestamp_seconds gauge",
        f"cortex_containers_scrape_timestamp_seconds {int(time.time())}",
    ]
    _atomic_write(OUTPUT, "\n".join(lines) + "\n")


def docker(argv):
    if len(argv) < 2 or argv[0] not in ("restart", "stop", "start"):
        sys.stderr.write("docker (sandbox shim): only `restart`, `stop` and `start` on named containers are simulated.\n")
        return 1
    verb, names = argv[0], argv[1:]
    state = _load(STATE)
    rc = 0
    for name in names:
        if name.startswith("-") or name not in state:
            sys.stderr.write(f"Error response from daemon: No such container: {name}\n")
            rc = 1
            continue
        s = state[name]
        if verb == "restart":
            s.update(state="running", health="healthy", restarts=s["restarts"] + 1)
        elif verb == "stop":
            s.update(state="exited", health="none")
        else:  # start
            if s["state"] != "running":
                s.update(state="running", health="healthy")
        print(name)  # real docker echoes each name it acted on
    _atomic_write(STATE, json.dumps(state, indent=2))
    render()
    return rc


def main():
    me = os.path.basename(sys.argv[0])
    if me == "docker":
        return docker(sys.argv[1:])
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "seed":
        seed()
    elif cmd == "render":
        render()
    else:
        return docker(sys.argv[1:])
    return 0


if __name__ == "__main__":
    sys.exit(main())
