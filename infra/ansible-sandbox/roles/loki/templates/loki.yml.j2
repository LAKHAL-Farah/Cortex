---
auth_enabled: false

server:
  http_listen_address: "{{ loki_bind_address }}"
  http_listen_port: {{ loki_http_port }}
  grpc_listen_port: 9096

common:
  path_prefix: "{{ loki_data_dir }}"

  storage:
    filesystem:
      chunks_directory: "{{ loki_data_dir }}/chunks"
      rules_directory: "{{ loki_data_dir }}/rules"

  replication_factor: 1

  ring:
    kvstore:
      store: inmemory

schema_config:
  configs:
    - from: "2024-01-01"
      store: tsdb
      object_store: filesystem
      schema: v13

      index:
        prefix: index_
        period: 24h

compactor:
  working_directory: "{{ loki_data_dir }}/compactor"
  retention_enabled: false

limits_config:
  allow_structured_metadata: true

analytics:
  reporting_enabled: false
