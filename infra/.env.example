CORTEX_DB_PASSWORD=insert-your-password-here
CORTEX_API_KEY=insert-your-api-key-here

# Auth (app/auth.py) -- real username/password accounts, replacing
# CORTEX_API_KEY above as the thing that gates the API.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CORTEX_JWT_SECRET=insert-a-long-random-secret-here
# Minutes a login session stays valid before the frontend has to log in
# again. Optional -- defaults to 480 (8h) if unset.
CORTEX_JWT_TTL_MINUTES=480
# Bootstrap admin account, created once on first startup if the `users`
# table is empty (see main.py::_seed_bootstrap_admin). You are forced to
# change this password on first login -- change these defaults before any
# real deployment, or at minimum log in and change the password immediately.
CORTEX_ADMIN_USERNAME=admin
CORTEX_ADMIN_PASSWORD=admin
PROMETHEUS_FILE_SD_HOST_DIR=insert-your-file-service-discovery-host-dir-here
CORTEX_ANSIBLE_HOST_DIR=insert-your-ansible-host-dir-here
CORTEX_SSH_KEY_HOST_DIR=insert-your-ssh-key-host-dir-here
# Host directory containing a clouds.yaml with a reader-only OpenStack
# service account (see docs/architecture/adr-0002-topology-graph.md).
# Never commit the real clouds.yaml -- this only points at where it lives
# on the host, same pattern as CORTEX_SSH_KEY_HOST_DIR above.
CORTEX_OPENSTACK_HOST_DIR=insert-your-openstack-clouds-yaml-host-dir-here
# Name of the `clouds:` entry in that clouds.yaml for topology sync to use.
OS_CLOUD=cortex-reader
CORTEX_NEO4J_PASSWORD=insert-your-neo4j-password-here

# RAG knowledge base (docs/knowledge/ -> Qdrant Cloud, embedded locally, adr-0004)
QDRANT_URL=insert-your-qdrant-cloud-cluster-url-here
QDRANT_API_KEY=insert-your-qdrant-cloud-api-key-here
QDRANT_COLLECTION=cortex-knowledge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Grounded chat over the knowledge base (docs cite sources, no hallucinated
# content, adr-0005) -- NVIDIA NIM chat model via LangChain's ChatNVIDIA.
# Get a key at https://build.nvidia.com/
NVIDIA_API_KEY=insert-your-nvidia-nim-api-key-here
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Fast tier (v0.8): router + node_resolver + monitoring/prediction narration.
# Must support .with_structured_output() *reliably*, not just once --
# mistralai/mistral-nemotron passed scripts/check_nvidia_models.py's single
# probe but intermittently returned malformed structured output in real
# traffic (wrong routing, failed node resolution). Defaulting to the same
# model as the reasoning tier until a small model is confirmed consistently
# clean on structured output.
NVIDIA_NIM_FAST_MODEL=nvidia/nemotron-3-super-120b-a12b
