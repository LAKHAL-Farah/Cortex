CORTEX_DB_PASSWORD=insert-your-password-here
CORTEX_API_KEY=insert-your-api-key-here

# Alert e-mails
ALERT_DEFAULT_RECIPIENT_EMAIL=ops@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=ops@example.com
SMTP_USERNAME=ops@example.com
SMTP_PASSWORD=replace-with-a-gmail-app-password
SMTP_STARTTLS=true
# Public URL of the Cortex web UI -- enables the "Open Cortex dashboard" button in the
# weekly digest email (hidden when unset). Digest schedule: Settings > Weekly digest.
CORTEX_PUBLIC_URL=

# Auth (app/auth.py) -- real username/password accounts, replacing
# CORTEX_API_KEY above as the thing that gates the API.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CORTEX_JWT_SECRET=insert-a-long-random-secret-here
# Minutes a login session stays valid before the frontend has to log in
# again. Optional -- defaults to 480 (8h) if unset.
CORTEX_JWT_TTL_MINUTES=480
# Bootstrap admin account, created once on first startup if the `users`
# table is empty (see main.py::_seed_bootstrap_admin). You are forced to
# change this password on first login -- change these defaults before any
# real deployment, or at minimum log in and change the password immediately.
CORTEX_ADMIN_USERNAME=admin
CORTEX_ADMIN_PASSWORD=admin
PROMETHEUS_FILE_SD_HOST_DIR=insert-your-file-service-discovery-host-dir-here
CORTEX_ANSIBLE_HOST_DIR=insert-your-ansible-host-dir-here
CORTEX_SSH_KEY_HOST_DIR=insert-your-ssh-key-host-dir-here
# Host directory containing a clouds.yaml with a reader-only OpenStack
# service account (see docs/architecture/adr-0002-topology-graph.md).
# Never commit the real clouds.yaml -- this only points at where it lives
# on the host, same pattern as CORTEX_SSH_KEY_HOST_DIR above.
CORTEX_OPENSTACK_HOST_DIR=insert-your-openstack-clouds-yaml-host-dir-here
# Name of the `clouds:` entry in that clouds.yaml for topology sync to use.
OS_CLOUD=cortex-reader

# --- FinOps (Quotas & Budget page) -----------------------------------------
# Private cloud = fixed bill, not a price list. Cortex derives per-unit rates
# from this monthly bill and the cloud's physical capacity (read from Nova
# hypervisors + Cinder backend pools; needs an admin-scoped cortex-reader).
# Total fixed monthly cost of the cloud in EUR (servers, bandwidth, ...):
FINOPS_MONTHLY_COST_EUR=292
# How the bill splits: compute (vCPU+RAM) / storage / shared platform nodes
# (controller, network, monitoring). Normalised, so any ratio works.
FINOPS_POOL_SHARE_COMPUTE=0.50
FINOPS_POOL_SHARE_STORAGE=0.30
FINOPS_POOL_SHARE_PLATFORM=0.20
# Overcommit the cloud is *planned* to be sold at (Nova's own defaults: 16 / 1.5)
FINOPS_CPU_ALLOCATION_RATIO=4.0
FINOPS_RAM_ALLOCATION_RATIO=1.0
# Used only if hypervisor / Cinder capacity can't be read from the API:
# FINOPS_FALLBACK_PHYSICAL_VCPUS=
# FINOPS_FALLBACK_PHYSICAL_RAM_GB=
# FINOPS_FALLBACK_STORAGE_GB=
# Optional pass-through charge per floating IP per month (0 = included in pool):
# FINOPS_FLOATING_IP_MONTH_EUR=0
# Department per project (bootstrap; editable on the page, or tag the Keystone
# project `department:<name>`):
# FINOPS_PROJECT_DEPARTMENTS={"mern-prod": "Engineering"}
# Budgets per project in EUR/month (bootstrap; editable on the page):
# QUOTA_PROJECT_BUDGETS_EUR={"mern-prod": 60}
CORTEX_NEO4J_PASSWORD=insert-your-neo4j-password-here

# RAG knowledge base (docs/knowledge/ -> Qdrant Cloud, embedded locally, adr-0004)
QDRANT_URL=insert-your-qdrant-cloud-cluster-url-here
QDRANT_API_KEY=insert-your-qdrant-cloud-api-key-here
QDRANT_COLLECTION=cortex-knowledge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Grounded chat over the knowledge base (docs cite sources, no hallucinated
# content, adr-0005) -- NVIDIA NIM chat model via LangChain's ChatNVIDIA.
# Get a key at https://build.nvidia.com/
NVIDIA_API_KEY=insert-your-nvidia-nim-api-key-here
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Fast tier (v0.8): router + node_resolver + monitoring/prediction narration.
# Must support .with_structured_output() *reliably*, not just once --
# mistralai/mistral-nemotron passed scripts/check_nvidia_models.py's single
# probe but intermittently returned malformed structured output in real
# traffic (wrong routing, failed node resolution). Defaulting to the same
# model as the reasoning tier until a small model is confirmed consistently
# clean on structured output.
NVIDIA_NIM_FAST_MODEL=nvidia/nemotron-3-super-120b-a12b
PROMETHEUS_URL=http://prometheus:9090

# OpenStack Expert Agent v1.0 (docs/architecture/adr-0010-openstack-expert-
# v1-expansion.md). Official-docs collection lives on the *same* Qdrant
# Cloud cluster as QDRANT_URL/QDRANT_API_KEY above -- just a different
# collection, so nothing new to provision there.
QDRANT_OFFICIAL_DOCS_COLLECTION=cortex-openstack-official-docs
OPENSTACK_DOCS_MIN_SCORE=0.25
OPENSTACK_DOCS_FETCH_TIMEOUT=15
# Community web-search fallback (Launchpad/mailing-list/Q&A, biased away
# from docs.openstack.org -- that's the tier above). Get a key at
# https://tavily.com/ ; leave unset to disable this tier entirely (it
# degrades to the original v0.6 "no runbook entry" answer instead, never
# an error -- see services/web_search.py).
TAVILY_API_KEY=insert-your-tavily-api-key-here

