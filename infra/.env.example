CORTEX_DB_PASSWORD=12345678
CORTEX_API_KEY=insert-your-api-key-here
# Alert e-mails: recipient is editable from Settings; SMTP values are only
# read by the API container and must remain out of Git in your local .env.
# Address that receives new HIGH and CRITICAL alert episodes.
ALERT_DEFAULT_RECIPIENT_EMAIL=ops@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Gmail: SMTP_FROM and SMTP_USERNAME are normally the same address. Generate
# an App Password at https://myaccount.google.com/apppasswords (not your normal
# Google password) and put it only in infra/.env, never in this example file.
SMTP_FROM=ops@example.com
SMTP_USERNAME=ops@example.com
SMTP_PASSWORD=replace-with-a-gmail-app-password
SMTP_STARTTLS=true
PROMETHEUS_FILE_SD_HOST_DIR=/home/ubuntu/RIFSTAGE/Cortex/infra/prometheus/file_sd
CORTEX_ANSIBLE_HOST_DIR=/home/ubuntu/RIFSTAGE/Cortex/infra/ansible-sandbox
CORTEX_SSH_KEY_HOST_DIR=/home/ubuntu/.ssh
# Host directory containing a clouds.yaml with a reader-only OpenStack
# service account (see docs/architecture/adr-0002-topology-graph.md).
# Never commit the real clouds.yaml -- this only points at where it lives
# on the host, same pattern as CORTEX_SSH_KEY_HOST_DIR above.
CORTEX_OPENSTACK_HOST_DIR=/home/ubuntu/RIFSTAGE/Cortex/infra/openstack
# Name of the `clouds:` entry in that clouds.yaml for topology sync to use.
OS_CLOUD=cortex-reader
CORTEX_NEO4J_PASSWORD=12345678

# RAG knowledge base (docs/knowledge/ -> Qdrant Cloud, embedded locally, adr-0004)
QDRANT_URL=https://your-cluster.region.cloud.qdrant.io:6333
QDRANT_API_KEY=replace-with-your-qdrant-api-key
QDRANT_COLLECTION=cortex-knowledge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Grounded chat over the knowledge base (docs cite sources, no hallucinated
# content, adr-0005) -- NVIDIA NIM chat model via LangChain's ChatNVIDIA.
# Get a key at https://build.nvidia.com/
NVIDIA_API_KEY=replace-with-your-nvidia-api-key
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
PROMETHEUS_URL=http://prometheus:9090
