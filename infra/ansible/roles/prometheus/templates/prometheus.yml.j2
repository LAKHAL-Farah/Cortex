global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: 'node_exporter'
    static_configs:
{% for host in groups['monitoring'] %}
      - targets: ['{{ hostvars[host].ansible_host }}:{{ node_exporter_port }}']
        labels:
          node: {{ host }}
          role: {{ hostvars[host].node_role }}
{% endfor %}

  - job_name: 'prometheus'
    static_configs:
      - targets:
          - '{{ hostvars[groups["prometheus_server"][0]].ansible_host }}:{{ prometheus_port }}'
        labels:
          node: '{{ groups["prometheus_server"][0] }}'
          role: '{{ hostvars[groups["prometheus_server"][0]].node_role }}'