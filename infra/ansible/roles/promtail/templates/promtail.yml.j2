server:
  http_listen_port: {{ promtail_http_port }}
  grpc_listen_port: 0

positions:
  filename: "{{ promtail_data_dir }}/positions.yaml"

clients:
  - url: "{{ loki_push_url }}"

scrape_configs:
  - job_name: system
    static_configs:
      - targets: [localhost]
        labels:
          host: "{{ inventory_hostname }}"
          role: "{{ node_role }}"
          __path__: /var/log/syslog

{% for service in promtail_services %}
  - job_name: "{{ service }}"
    static_configs:
      - targets: [localhost]
        labels:
          host: "{{ inventory_hostname }}"
          role: "{{ node_role }}"
          service: "{{ service }}"
          __path__: "/var/log/kolla/{{ service }}/*.log"
{% endfor %}
