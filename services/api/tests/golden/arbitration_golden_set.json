      "id": "connects_relationship_skipped_not_guessed",
      "description": "CONNECTS isn't in the directionality table -- both endpoints anomalous, but must be skipped outright, never defaulted to a direction.",
      "vertices": {
        "sub-1": {"label": "Subnet", "outgoing": [
          {"id": "net-1", "label": "Network", "relationship": "CONNECTS", "direction": "outgoing"}
