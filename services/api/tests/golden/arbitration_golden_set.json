{
  "_comment": "v0.7 (adr-0009) arbitration golden set. Each scenario feeds app.services.rca_suggester.find_causal_suggestions the same shapes test_rca_suggester.py already mocks (a vertices map answering graph_db.fetch_vertex_detail, plus AnomalyFlag rows) and asserts the exact set of (cause_id, effect_id, relationship) triples it must produce -- this is the system's one existing deterministic 'given several concurrent anomalies, which one is the likely root cause' engine, and the closest real analog to the v0.7 brief's 'arbitration' concept until a second investigating agent exists (see compose.py's docstring). Scenarios 1-9 are the exact fixtures test_rca_suggester.py already exercises (same demo topology, same hostnames) -- reused here, not reinvented, so this golden set can't silently drift from what that unit test already pins down. Scenarios 10-13 are new synthetic incidents built from the same real, already-implemented directionality table (_DIRECTION in rca_suggester.py) to cover chained/multi-pair cases no single unit test covers today.",
  "scenarios": [
    {
      "id": "runs_on_node_causes_service",
      "description": "compute-02 (Node) is critically CPU-anomalous; nova-compute@compute-02 (Service, RUNS_ON compute-02) is also anomalous -> the node is the cause.",
      "vertices": {
        "compute-02": {"label": "Node", "outgoing": [], "incoming": [
          {"id": "nova-compute@compute-02", "label": "Service", "relationship": "RUNS_ON", "direction": "incoming"}
        ]},
        "nova-compute@compute-02": {"label": "Service", "outgoing": [
          {"id": "compute-02", "label": "Node", "relationship": "RUNS_ON", "direction": "outgoing"}
        ], "incoming": []}
      },
      "flags": [
        {"hostname": "compute-02", "metric_name": "cpu_usage", "severity": "critical"},
        {"hostname": "nova-compute@compute-02", "metric_name": "cpu_usage", "severity": "high"}
      ],
      "expected_suggestions": [
        {"cause_id": "compute-02", "effect_id": "nova-compute@compute-02", "relationship": "RUNS_ON"}
      ]
    },
    {
      "id": "no_edge_no_suggestion",
      "description": "Two anomalous nodes with no graph edge between them -- never guess a relationship.",
      "vertices": {
        "compute-02": {"label": "Node", "outgoing": [], "incoming": []},
        "storage-09": {"label": "Node", "outgoing": [], "incoming": []}
      },
      "flags": [
        {"hostname": "compute-02", "metric_name": "cpu_usage", "severity": "high"},
        {"hostname": "storage-09", "metric_name": "ram_usage", "severity": "high"}
      ],
      "expected_suggestions": []
    },
    {
      "id": "neighbor_not_anomalous_no_suggestion",
      "description": "Only one side of a real edge is anomalous -- no pair to correlate.",
      "vertices": {
        "compute-02": {"label": "Node", "outgoing": [], "incoming": [
          {"id": "nova-compute@compute-02", "label": "Service", "relationship": "RUNS_ON", "direction": "incoming"}
        ]},
        "nova-compute@compute-02": {"label": "Service", "outgoing": [
          {"id": "compute-02", "label": "Node", "relationship": "RUNS_ON", "direction": "outgoing"}
        ], "incoming": []}
