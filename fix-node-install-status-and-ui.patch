 ANSIBLE_DIR = Path(os.environ.get("CORTEX_ANSIBLE_DIR") or _default_ansible_dir())
 SITE_PLAYBOOK = ANSIBLE_DIR / "site.yml"
 
+
+def _host_ran_in_recap(output: str, hostname: str) -> bool:
+    """Return True only if the PLAY RECAP shows this host actually ran tasks
+    (ok > 0). A host that never matched --limit simply has no recap line at
+    all, and Ansible's exit code doesn't reliably flag that case."""
+    pattern = re.compile(_RECAP_LINE_RE_TEMPLATE.format(host=re.escape(hostname)), re.MULTILINE)
+    match = pattern.search(output)
+    if not match:
+        return False
+    ok_count = int(match.group(1))
+    return ok_count > 0
+
